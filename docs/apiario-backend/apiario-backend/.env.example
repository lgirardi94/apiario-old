# =========================================================
#  Configurazione backend "Il Mio Apiario"
#  Copia questo file in .env e riempi i valori.
#  Il file .env NON va mai committato nel repository.
# =========================================================

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database PostgreSQL ----
# Stringa di connessione completa fornita dall'hosting (es. DigitalOcean, Render).
# Formato: postgresql://utente:password@host:porta/nomedb
DATABASE_URL=postgresql://localhost:5432/apiario

# Imposta a "true" se il provider richiede SSL (la maggior parte degli hosting gestiti sì).
DATABASE_SSL=false

# ---- JWT (sessioni) ----
# Chiave segreta lunga e casuale per firmare i token. Generane una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-questo-con-una-stringa-lunga-e-casuale
# Durata del token di sessione.
JWT_EXPIRES_IN=7d

# ---- bcrypt ----
# Cost factor (più alto = più sicuro ma più lento). 12 è un buon valore.
BCRYPT_COST=12

# ---- Token email (verifica e reset) ----
# Validità del link di verifica email.
VERIFY_TOKEN_TTL_HOURS=24
# Validità del link di reset password (breve perché sensibile).
RESET_TOKEN_TTL_HOURS=1

# ---- Email (Brevo) ----
# Chiave API ottenuta dal pannello Brevo (sezione SMTP & API).
BREVO_API_KEY=la-tua-chiave-brevo
# Mittente delle email (deve essere un indirizzo verificato su Brevo).
EMAIL_FROM=noreply@tuodominio.ch
EMAIL_FROM_NAME=Il Mio Apiario

# ---- Frontend ----
# URL pubblico del frontend: usato per costruire i link nelle email e per il CORS.
# In sviluppo può essere http://localhost:5500 o simile.
FRONTEND_URL=https://tuonome.github.io/il-mio-apiario

# ---- Primo amministratore (opzionale) ----
# Se un utente si registra con QUESTA email, diventa admin in automatico.
# Comodo al primo avvio: niente passaggi manuali. Lascia vuoto per disattivare.
# In alternativa (o in aggiunta) puoi usare lo script ./scripts/create-admin.sh.
FIRST_ADMIN_EMAIL=
